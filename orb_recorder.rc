/* Windows resource file for ORB_Recorder.
 * Compiled by windres into orb_recorder_res.o, linked into orb_recorder.exe.
 * The IDI_ORB icon becomes the exe icon (Explorer / taskbar / alt-tab).
 */
#include <windows.h>

#define IDI_ORB 101

IDI_ORB ICON "orb.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,6,0,0
PRODUCTVERSION  3,6,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Alex Maximilius (Alex Maz) / 324x"
            VALUE "FileDescription",  "ORB_Recorder - always-on-top screen recorder"
            VALUE "FileVersion",      "3.6.0.0"
            VALUE "InternalName",     "orb_recorder"
            VALUE "OriginalFilename", "orb_recorder.exe"
            VALUE "ProductName",      "ORB_Recorder"
            VALUE "ProductVersion",   "3.6.0.0"
            VALUE "LegalCopyright",   "Public domain - Alex Maz, 2026"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
